# 로컬 개발용 비밀값 — 이 파일을 복사해서 `.dev.vars` 로 저장하고 값을 채우세요.
# `.dev.vars` 는 .gitignore에 들어 있어야 하며, 절대 커밋·공유하지 않습니다.
# 배포용은 파일이 아니라 `npx wrangler secret put <이름>` 으로 넣습니다.
#
# ⚠️ 여기 값을 하나도 안 채워도 오피스는 정상 작동합니다.
#    (연동 항목만 화면에 "미설정"으로 표시됩니다)
#    나중에 진짜 Notion·Slack에 보고서를 보내고 싶을 때만 채우세요.

# ── Notion ─────────────────────────────────────────────
# 1) https://www.notion.so/my-integrations 에서 내부 통합 생성 → Secret 복사 (ntn_ 로 시작)
# 2) 보고서를 받을 Notion 페이지(또는 데이터베이스) 열기 → 우측 상단 ⋯ → 연결 → 만든 통합 추가
#    (이 2단계를 안 하면 API가 404를 냅니다)
NOTION_TOKEN=
# 보고서를 저장할 페이지 또는 데이터베이스 ID (Notion 주소의 32자리 문자열)
# 그냥 평범한 페이지여도 됩니다 — 표(데이터베이스)가 아니면 그 페이지 아래에
# 브리핑을 블록으로 자동으로 붙여넣습니다.
NOTION_BRIEFING_DB=

# ── Slack ──────────────────────────────────────────────
# 1) https://api.slack.com/apps 에서 앱 생성 (또는 기존 앱 사용)
# 2) 왼쪽 메뉴 "Incoming Webhooks" 켜기 → "Add New Webhook to Workspace"
# 3) 보고를 받을 채널 선택 → 생성된 Webhook URL 복사 (https://hooks.slack.com/services/... 형태)
SLACK_WEBHOOK_URL=

# ── OpenAI (직원 1:1 대화) ──────────────────────────────
# 1) https://platform.openai.com/api-keys 에서 API 키 생성 (로그인 필요, 결제 수단 등록 필요)
# 2) sk-로 시작하는 키 복사
# ⚠️ 사용한 만큼 과금됩니다 (저렴하지만 무료는 아니에요).
#    안 채우면 직원 1:1 대화는 규칙 기반(정해진 패턴) 답변으로 자동 대체됩니다 — 앱이 깨지지 않아요.
OPENAI_API_KEY=
